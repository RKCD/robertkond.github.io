{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkcd.github.io/robertkond.github.io/docs/profiil.schema.json",
  "title": "AI-valmis ettevõtteprofiil (kavand v0.1)",
  "description": "Moodul 1. Kliendi kinnitatud andmed (confirmed) ja AI või meie pakutud ettepanekud (proposals) on eraldi. JSON-LD genereeritakse ainult confirmed-osast. Päris kliendiprofiilid ei kuulu sellesse avalikku reposse.",
  "type": "object",
  "required": ["schema_version", "company_id", "confirmed", "proposals"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "company_id": { "type": "string", "description": "Sisemine id, nt registrikood." },
    "schema_org_type": { "type": "string", "default": "LocalBusiness", "examples": ["HVACBusiness", "Electrician", "Plumber", "HomeAndConstructionBusiness"] },
    "confirmed": { "$ref": "#/$defs/profile", "description": "Ainult kliendi kinnitatud faktid. Avaldatakse." },
    "proposals": {
      "type": "array",
      "description": "Ettepanekud, mida klient pole kinnitanud. Ei avaldata kunagi.",
      "items": {
        "type": "object",
        "required": ["field", "proposed_value", "origin", "created_on", "status"],
        "properties": {
          "field": { "type": "string", "description": "JSON pointer confirmed-osas, nt /services/0/description" },
          "proposed_value": {},
          "origin": { "enum": ["ai", "analyst", "measurement"] },
          "reason": { "type": "string" },
          "created_on": { "type": "string", "format": "date" },
          "status": { "enum": ["open", "accepted", "rejected"] }
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Muudatuste ajalugu (moodul 3).",
      "items": {
        "type": "object",
        "required": ["on", "field", "change", "confirmed_by"],
        "properties": {
          "on": { "type": "string", "format": "date" },
          "field": { "type": "string" },
          "change": { "type": "string" },
          "confirmed_by": { "type": "string", "description": "Kliendi kontaktisiku nimi või roll." }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["value", "source", "checked_on"],
      "properties": {
        "value": {},
        "source": { "type": "string", "description": "Kust info pärineb: URL, dokument või 'klient, e-kiri AAAA-KK-PP'." },
        "checked_on": { "type": "string", "format": "date" }
      }
    },
    "service": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "area_served": { "type": "array", "items": { "type": "string" } },
        "excludes": { "type": "array", "items": { "type": "string" }, "description": "Mida selle teenuse all ei tehta." },
        "price_info": { "type": "string", "description": "Ainult kui klient esitab." }
      }
    },
    "profile": {
      "type": "object",
      "required": ["legal_name", "services", "area_served", "contact", "next_step", "last_verified_on"],
      "properties": {
        "legal_name": { "$ref": "#/$defs/fact" },
        "brand_name": { "$ref": "#/$defs/fact" },
        "registry_code": { "$ref": "#/$defs/fact" },
        "url": { "$ref": "#/$defs/fact" },
        "services": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/service" } },
        "area_served": { "$ref": "#/$defs/fact" },
        "audience": { "$ref": "#/$defs/fact", "description": "Sihtkliendid: eraisikud, KÜ-d, ettevõtted…" },
        "contact": {
          "type": "object",
          "properties": {
            "phone": { "$ref": "#/$defs/fact" },
            "email": { "$ref": "#/$defs/fact" },
            "address": { "$ref": "#/$defs/fact" }
          }
        },
        "opening_hours": { "$ref": "#/$defs/fact", "description": "schema.org openingHours kuju, nt 'Mo-Fr 08:00-17:00'." },
        "availability_note": { "$ref": "#/$defs/fact", "description": "Nt avariiteenus 24/7, ooteaeg." },
        "limits": { "$ref": "#/$defs/fact", "description": "Üldised piirangud ja välistused." },
        "languages": { "$ref": "#/$defs/fact" },
        "certifications": {
          "type": "array",
          "description": "Ainult kontrollitud. verified_against peab olema täidetud.",
          "items": {
            "type": "object",
            "required": ["name", "verified_against", "checked_on"],
            "properties": {
              "name": { "type": "string" },
              "issuer": { "type": "string" },
              "verified_against": { "type": "string", "description": "Register või dokument, millega kontrolliti." },
              "valid_until": { "type": "string", "format": "date" },
              "checked_on": { "type": "string", "format": "date" }
            }
          }
        },
        "next_step": { "$ref": "#/$defs/fact", "description": "Kuidas küsida hinnapakkumist või broneerida." },
        "faq": {
          "type": "array",
          "items": { "type": "object", "required": ["q", "a"], "properties": { "q": { "type": "string" }, "a": { "type": "string" } } }
        },
        "last_verified_on": { "type": "string", "format": "date" }
      }
    }
  }
}
